{
  "name": "yaga",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --scheme yaga-go",
    "tunnel": "expo start --tunnel --dev-client --scheme yaga-go",
    "start:tunnel": "expo start --dev-client --scheme yaga-go --tunnel --clear",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx && tsc --noEmit",
    "android": "expo run:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^12.0.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.0.0",
    "@types/react": "~19.2.10",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-auth-session": "~55.0.17",
    "expo-blur": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-document-picker": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-keep-awake": "~55.0.8",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-notifications": "~55.0.25",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-sensors": "~55.0.17",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.26",
    "immer": "^9.0.19",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-nitro-modules": "0.31.10",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "babel-preset-expo": "~55.0.8",
    "baseline-browser-mapping": "^2.9.17",
    "better-sqlite3": "^12.6.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-sqlite-mock": "^3.0.0",
    "globals": "^17.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "prettier": "2.8.4",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "expo-sqlite-mock/src/setup.ts"
    ],
    "testTimeout": 10000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/ios/"
    ]
  },
  "private": true
}
